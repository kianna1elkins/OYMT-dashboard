# Copy to .env for local development (never commit the real .env).

# Postgres connection string. Railway sets this automatically when you add a
# Postgres database and reference it. Leave unset locally to use in-memory storage.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Set to "true" only if your Postgres requires SSL (e.g. connecting over the
# public internet). Railway's internal connection does not need this.
# DATABASE_SSL=false

# Optional shared password. If set, the whole site asks for a login.
# Any username works; the password must match this value.
# APP_PASSWORD=changeme

# Port (Railway sets this automatically).
# PORT=3000
